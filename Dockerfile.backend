FROM python:3.12-slim

WORKDIR /app

# 安装系统依赖（psycopg2 需要 libpq）
# Render 服务器在国外，使用官方 Debian 源（国内构建时可加 --build-arg 切换镜像）
RUN apt-get update && apt-get install -y --no-install-recommends libpq-dev curl gcc python3-dev \
    && rm -rf /var/lib/apt/lists/*

COPY backend/requirements.txt .
# 使用官方 PyPI 源（Render 在国外，官方源更快）
RUN pip install --no-cache-dir -r requirements.txt

# 安装完成后清理构建工具，减小镜像体积
RUN apt-get purge -y --auto-remove gcc python3-dev

# 复制后端代码（context 是 intelli-job/，代码在 backend/ 下）
COPY backend/app/ ./app/
COPY backend/init_db.py ./init_db.py
COPY backend/.env.example ./.env.example

EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
