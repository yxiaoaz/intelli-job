FROM python:3.12-slim

WORKDIR /app

# PyPI 镜像源可按构建环境选择：
# - GitHub Actions（美国机房）走官方 PyPI 更快，默认即 pypi.org
# - 国内本地构建传 --build-arg PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
ARG PIP_INDEX_URL=https://pypi.org/simple

# 安装系统依赖（psycopg2 需要 libpq）
RUN apt-get update && apt-get install -y --no-install-recommends libpq-dev curl gcc python3-dev \
    && rm -rf /var/lib/apt/lists/*

COPY backend/requirements.txt .
RUN pip install --no-cache-dir -i ${PIP_INDEX_URL} -r requirements.txt

# 安装完成后清理构建工具，减小镜像体积
RUN apt-get purge -y --auto-remove gcc python3-dev

# 复制后端代码（context 是 intelli-job/，代码在 backend/ 下）
COPY backend/app/ ./app/
COPY backend/init_db.py ./init_db.py
COPY backend/.env.example ./.env.example

EXPOSE 8000

# --proxy-headers：信任 Caddy 反代传来的 X-Forwarded-For，
# 使 request.client 反映真实客户端 IP（限流 key 与日志依赖此头，api-abuse-protection）
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers", "--forwarded-allow-ips=127.0.0.1"]
