# Application Settings
APP_NAME=Intelli-Job API
APP_VERSION=1.0.0
DEBUG=False

# Database (PostgreSQL RDS)
RDS_DRIVERNAME=postgresql+asyncpg
RDS_USERNAME=postgres
RDS_PASSWORD=password
RDS_HOST=localhost
RDS_PORT=5432
RDS_DB_NAME=intellijob

# Redis
REDIS_HOST=localhost
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_DB=0

# JWT
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# LLM - Completion (DeepSeek)
# 当 backend/llm_providers.yaml 存在时，以下变量仅作 YAML 缺失时的回退
LLM_COMPLETION_API_KEY=your-deepseek-api-key
LLM_COMPLETION_API_URL=https://api.deepseek.com
LLM_COMPLETION_API_MODEL_NAME=deepseek-chat

# LLM - Completion 多供应商 fallback（llm_providers.yaml 中以 ${VAR} 引用）
# 注意：Qwen key 与下面 embedding 的 DashScope key 相同
LLM_DEEPSEEK_API_KEY=your-deepseek-api-key
LLM_QWEN_API_KEY=your-qwen-api-key
LLM_GLM_API_KEY=your-glm-api-key

# LLM - Embedding (Alibaba Qwen)
LLM_EMBEDDING_API_KEY=your-qwen-api-key
LLM_EMBEDDING_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_EMBEDDING_API_MODEL_NAME=text-embedding-v4

# Zilliz Cloud (Vector DB)
ZILLIZ_URI=your-zilliz-uri
ZILLIZ_TOKEN=your-zilliz-token
ZILLIZ_JOB_ITEM_COLLECTION_NAME=job_items

# Aliyun OSS (Object Storage for resumes)
OSS_ACCESS_KEY_ID=your-oss-access-key-id
OSS_ACCESS_KEY_SECRET=your-oss-access-key-secret
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_BUCKET_NAME=intellijob-resumes

# Rate Limiting（api-abuse-protection：三档限流，均带默认值可不填）
RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_AUTH_PER_MINUTE=5
RATE_LIMIT_AI_PER_MINUTE=10

# Abuse Protection（资源天花板与用途治理，均带默认值可不填）
CHAT_MESSAGE_MAX_LENGTH=5000
CHAT_DAILY_MESSAGE_LIMIT=50
REPARSE_HOURLY_LIMIT=3
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15
RESUME_MAX_FILE_MB=10

# CORS (生产环境设置为 Vercel 域名)
CORS_ORIGINS=*

# Environment (dev | prod)
# - dev: Intent files stored in ~/.intelli-job/intents
# - prod: Intent files stored in /opt/intelli-job/data/intents
ENVIRONMENT=dev
